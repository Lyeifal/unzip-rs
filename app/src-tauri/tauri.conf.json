{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "自动解压工具",
  "version": "0.1.0",
  "identifier": "com.unzip.app",
  "mainBinaryName": "unzip-app",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "自动解压工具",
        "width": 920,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1520",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/bundled"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
